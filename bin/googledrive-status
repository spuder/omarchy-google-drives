#!/usr/bin/python3 -I
"""Read-only status helper for the Google Drives Quickshell panel.

Prints one JSON object on stdout, shaped for Model.js's parseAccounts():

    {"ok": true, "rcloneInstalled": bool, "setupComplete": bool,
     "accounts": [...], "lastError": ""}

setupComplete is everything install.sh puts in place — rclone, fuse3's
fusermount3, and the systemd user template. `omarchy plugin add` has no
post-install hook, so the panel uses this to decide whether its first
"Add account" click has to run install.sh before signing in.

Each account comes from ~/.config/omarchy-google-drive/accounts.json
(written by googledrive-accountctl) plus two checks: whether its systemd
user unit is active (-> "active" — cheap and local, so this always runs
fresh), and whether `rclone about` succeeds against its own per-account
config (-> "authenticated", plus usage/quota when it does).

The `rclone about` check is cached per account (see CACHE_TTL_SECONDS): the
panel refreshes every ~30s by default, and polling Drive's quota API live
on every refresh — for every account — isn't something to do by accident.
A healthy result is trusted for the TTL; an error is always rechecked
immediately, so a lapsed/expired sign-in doesn't stay hidden behind a stale
cache. Same pattern as the sister Proton Drive plugin's status script.

Never raises — a missing rclone, a missing config directory, or a hung
`rclone about` call all degrade to a normal-looking JSON object with the
account's `lastError` field set, rather than crashing the panel.

--demo prints a fixed two-account fixture instead of touching the real
config or rclone.
"""

import configparser
import json
import os
import selectors
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path

STATE_HOME = Path.home() / ".config" / "omarchy-google-drive"
ACCOUNTS_FILE = STATE_HOME / "accounts.json"
UNIT_TEMPLATE = "omarchy-google-drive-mount@{id}.service"
CACHE_TTL_SECONDS = 600

# This script is launched automatically on a timer by the shell process,
# not typed by a human each time — so `rclone` is resolved from a fixed,
# trusted directory rather than whatever PATH the calling process happened
# to inherit, and `systemctl` is hardcoded outright (its location is
# standard on any systemd distro). /usr/local/bin is deliberately not
# included: nothing this script calls actually lives there, so it isn't
# trusted unverified. Kept identical to googledrive-accountctl's own
# TRUSTED_PATH/SYSTEMCTL — update both together if either changes.
TRUSTED_PATH = "/usr/bin"
SYSTEMCTL = "/usr/bin/systemctl"
# Combined stdout+stderr cap for run_bounded() below — `rclone about --json`
# returns a small object (order of hundreds of bytes) and systemctl's own
# output is similarly tiny, so this is generous headroom, not a tight
# budget; it exists so a malicious or malfunctioning remote genuinely
# cannot grow this process's memory past a fixed bound, matching
# Service.qml's BoundedCollector on the QML side of the same boundary.
MAX_OUTPUT_BYTES = 262144


def demo_payload():
    return {
        "ok": True,
        "rcloneInstalled": True,
        "setupComplete": True,
        "accounts": [
            {
                "id": "personal",
                "displayName": "Personal",
                "authenticated": True,
                "active": True,
                "statusText": "Mounted",
                "mountPath": str(Path.home() / "GoogleDrive" / "Personal"),
                "usedBytes": 4_200_000_000,
                "quotaBytes": 20_000_000_000,
                "quotaKnown": True,
                "lastError": "",
            },
            {
                "id": "work",
                "displayName": "Work",
                "authenticated": True,
                "active": False,
                "statusText": "Paused",
                "mountPath": str(Path.home() / "GoogleDrive" / "Work"),
                "usedBytes": 900_000_000_000,
                "quotaBytes": 2_000_000_000_000,
                "quotaKnown": True,
                "lastError": "",
            },
        ],
        "lastError": "",
    }


def run_bounded(command, timeout, max_bytes=MAX_OUTPUT_BYTES):
    """Run `command`, returning (exit_code, stdout_text, stderr_text) with
    combined output hard-capped at max_bytes.

    subprocess.run(..., capture_output=True) buffers the child's entire
    stdout/stderr before this process ever looks at it — for a call whose
    output is remote-derived (`rclone about` talking to Drive's API), a
    malicious or just malfunctioning remote/rclone response could grow
    that buffer arbitrarily before anything here gets a chance to bound
    it. This reads both pipes incrementally instead, tripping the same
    kill path as the timeout the moment the combined total crosses
    max_bytes. The child also runs in its own process group
    (start_new_session=True) specifically so that kill reaches anything
    it spawned in turn, not just the one PID Popen hands back — plain
    subprocess.run(..., timeout=...)'s own timeout kill only ever signals
    the direct child. Used for every call whose output either comes from
    a remote (rclone) or isn't otherwise bounded by the caller.
    """
    try:
        proc = subprocess.Popen(
            command, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            start_new_session=True,
        )
    except OSError:
        return 1, "", ""

    sel = selectors.DefaultSelector()
    sel.register(proc.stdout, selectors.EVENT_READ, "stdout")
    sel.register(proc.stderr, selectors.EVENT_READ, "stderr")
    buffers = {"stdout": bytearray(), "stderr": bytearray()}
    total = 0
    tripped = False
    deadline = time.monotonic() + timeout
    open_streams = 2

    while open_streams > 0:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            tripped = True
            break
        for key, _ in sel.select(timeout=min(remaining, 0.5)):
            chunk = key.fileobj.read(65536)
            if not chunk:
                sel.unregister(key.fileobj)
                open_streams -= 1
                continue
            total += len(chunk)
            if total > max_bytes:
                tripped = True
                break
            buffers[key.data].extend(chunk)
        if tripped:
            break
    sel.close()

    if tripped:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError):
            pass
        exit_code = 1
    else:
        try:
            exit_code = proc.wait(timeout=max(0.1, deadline - time.monotonic()))
        except subprocess.TimeoutExpired:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except (ProcessLookupError, PermissionError):
                pass
            exit_code = 1

    try:
        proc.wait(timeout=2)
    except subprocess.TimeoutExpired:
        pass
    proc.stdout.close()
    proc.stderr.close()

    return (
        exit_code,
        buffers["stdout"].decode("utf-8", "replace"),
        buffers["stderr"].decode("utf-8", "replace"),
    )


def command_output(command, timeout=4):
    exit_code, stdout, _stderr = run_bounded(command, timeout)
    return exit_code, stdout.strip()


def load_accounts():
    if not ACCOUNTS_FILE.exists():
        return []
    try:
        with ACCOUNTS_FILE.open("r", encoding="utf-8") as handle:
            data = json.load(handle)
    except (OSError, json.JSONDecodeError):
        return []
    accounts = data.get("accounts") if isinstance(data, dict) else None
    return accounts if isinstance(accounts, list) else []


def config_has_token(config_path):
    """True if the account's rclone.conf has a non-empty OAuth token saved
    — a cheap local check that doesn't need a network round trip. Doesn't
    assume the section name matches the account id (rclone names it from
    whatever was passed to `config create`, which has always been the
    account id here, but this reads whichever section exists rather than
    assuming). Checks the option's presence before reading its value —
    the actual token content is never assigned to a named variable, logged,
    or returned, only compared against blank inline, consistent with
    treating this as a credential the CLI owns rather than one this
    plugin holds onto."""
    parser = configparser.ConfigParser()
    try:
        parser.read(config_path)
    except configparser.Error:
        return False
    for section in parser.sections():
        if parser.has_option(section, "token") and parser.get(section, "token").strip():
            return True
    return False


def unit_active(account_id):
    unit = UNIT_TEMPLATE.format(id=account_id)
    exit_code, _ = command_output([SYSTEMCTL, "--user", "is-active", "--quiet", unit], timeout=3)
    return exit_code == 0


def cache_path(account_id):
    return STATE_HOME / account_id / "quota-cache.json"


def load_cache(account_id):
    path = cache_path(account_id)
    # Same symlink rejection as googledrive-accountctl's accounts.json
    # reads, added during a security self-review pass: reading through a
    # pre-placed symlink here can't cross a privilege boundary (this is
    # the same user's own directory either way) but it can feed
    # arbitrary file content into json.loads() below as if it were this
    # account's own cache, so it's rejected outright rather than trusted.
    if path.is_symlink():
        return None
    if not path.exists():
        return None
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None


def save_cache(account_id, data):
    path = cache_path(account_id)
    if path.exists() and path.is_symlink():
        return  # see load_cache's matching comment; just skip the write
    # Exclusive, unpredictable temp name (see googledrive-accountctl's
    # atomic_write_accounts, which has the identical reasoning) rather
    # than a fixed ".json.tmp" — this is only quota numbers, not anything
    # sensitive, but the write pattern should still not be one a
    # pre-placed symlink at a guessable name could redirect.
    fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=".quota-cache.", suffix=".json.tmp")
    tmp = Path(tmp_name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(json.dumps(data))
        tmp.replace(path)  # same directory, so this is an atomic rename
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise


def fetch_quota(rclone_path, remote, config_path):
    """One live `rclone about` call. Returns a dict with authenticated/
    usedBytes/quotaBytes/quotaKnown/lastError/statusHint — never raises."""
    exit_code, output = command_output(
        [rclone_path, "about", f"{remote}:", "--config", str(config_path), "--json"],
        timeout=6,
    )
    if exit_code != 0:
        return {
            "authenticated": False, "usedBytes": 0, "quotaBytes": 0, "quotaKnown": False,
            "lastError": "Sign-in expired or network unreachable", "statusHint": "Needs attention",
        }
    try:
        about = json.loads(output)
    except json.JSONDecodeError:
        about = {}
    used = about.get("used")
    total = about.get("total")
    return {
        "authenticated": True,
        "usedBytes": used if isinstance(used, (int, float)) else 0,
        "quotaBytes": total if isinstance(total, (int, float)) and total > 0 else 0,
        "quotaKnown": isinstance(total, (int, float)) and total > 0,
        "lastError": "",
        "statusHint": "",
    }


def account_status(rclone_path, entry):
    account_id = str(entry.get("id", ""))
    display_name = str(entry.get("displayName", account_id))
    remote = str(entry.get("remote", account_id))
    mount_path = str(entry.get("mountPath", ""))
    config_path = STATE_HOME / account_id / "rclone.conf"

    active = unit_active(account_id) if account_id else False
    result = {
        "id": account_id,
        "displayName": display_name,
        "authenticated": False,
        "active": active,
        "statusText": "Paused" if not active else "Mounted",
        "mountPath": mount_path,
        "usedBytes": 0,
        "quotaBytes": 0,
        "quotaKnown": False,
        "lastError": "",
    }

    if rclone_path is None:
        result["lastError"] = "rclone is not installed"
        return result
    if not config_path.exists() or not config_has_token(config_path):
        # A config file can exist without a completed OAuth exchange — a
        # browser sign-in that was closed before approving, or interrupted.
        # Checking locally avoids reporting a misleading "expired" for an
        # account that never actually finished signing in.
        result["lastError"] = "Not signed in yet"
        return result

    # A healthy quota check is cached for CACHE_TTL_SECONDS to avoid polling
    # Drive's API on every panel refresh. An error is never cached — always
    # recheck immediately, so an expired sign-in shows up right away
    # instead of waiting out the TTL.
    cache = load_cache(account_id)
    fresh_enough = (
        cache is not None
        and cache.get("authenticated") is True
        and not cache.get("lastError")
        and (time.time() - cache.get("checkedAt", 0)) < CACHE_TTL_SECONDS
    )

    quota = cache if fresh_enough else fetch_quota(rclone_path, remote, config_path)
    if not fresh_enough:
        save_cache(account_id, dict(quota, checkedAt=time.time()))

    result["authenticated"] = quota["authenticated"]
    result["usedBytes"] = quota["usedBytes"]
    result["quotaBytes"] = quota["quotaBytes"]
    result["quotaKnown"] = quota["quotaKnown"]
    result["lastError"] = quota["lastError"]
    result["statusText"] = quota["statusHint"] or ("Mounted" if active else "Paused")
    return result


def setup_complete(rclone_path):
    unit = Path.home() / ".config" / "systemd" / "user" / "omarchy-google-drive-mount@.service"
    return (
        rclone_path is not None
        and shutil.which("fusermount3", path=TRUSTED_PATH) is not None
        and unit.is_file()
    )


def main():
    if "--demo" in sys.argv[1:]:
        print(json.dumps(demo_payload()))
        return

    rclone_path = shutil.which("rclone", path=TRUSTED_PATH)
    entries = load_accounts()
    accounts = [account_status(rclone_path, entry) for entry in entries if isinstance(entry, dict)]

    print(json.dumps({
        "ok": True,
        "rcloneInstalled": rclone_path is not None,
        "setupComplete": setup_complete(rclone_path),
        "accounts": accounts,
        "lastError": "",
    }))


if __name__ == "__main__":
    main()
