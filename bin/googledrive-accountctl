#!/usr/bin/python3 -I
"""Manage Google Drive accounts: add, remove, pause, resume, list.

State lives under ~/.config/omarchy-google-drive/:
  accounts.json         list of {id, displayName, remote, mountPath}
  <id>/rclone.conf       that account's own rclone config (never shared
                         across accounts, so revoking or corrupting one
                         can't touch another — same isolation model as the
                         sister Proton Drive plugin, see PLAN.md)
  <id>/env               GOOGLEDRIVE_* vars consumed by the systemd unit

`add` is meant to run inside a terminal (Service.qml's "Add account" button
launches a floating one) because Google Drive sign-in is rclone's own
browser OAuth flow: `rclone config create ... drive` starts a local
webserver, prints/opens an auth URL, and blocks until you approve it in
your browser. There is no password or 2FA code for this plugin to collect
itself — unlike the Proton Drive plugin, which has to prompt for
credentials because Proton's rclone backend does its own SRP login. That's
also why there's no --json/stdin form here: nothing sensitive ever needs to
reach this script directly, Google's own consent screen handles it.

The account label you're asked for is your Google email, not an invented
short id — but the email itself never becomes the systemd instance name,
rclone remote name, or directory name directly. `@`/`.` in those contexts
reads badly (two `@`s in "omarchy-google-drive-mount@alice@gmail.com" is
genuinely ambiguous about which one is the systemd template separator) and
exposes the full address in `systemctl`/`journalctl` output for no benefit.
`slugify_email` takes the part before '@' instead (alice@gmail.com ->
alice); the email itself is kept as the human-readable displayName shown
in the panel and used for the mount folder name, where `@`/`.` are
perfectly normal filename characters. Two accounts that happen to share a
local part (alice@gmail.com and alice@work.com) don't collide on id —
`unique_id` appends -2, -3, ... rather than baking the domain into every
id just to guard against a case that's rare in practice.

Once sign-in verifies, `add` enables and starts the mount unit itself and
fires a desktop notification — deliberately not just printing instructions
and leaving the terminal window to be found again. Google's own OAuth
consent screen takes over the whole browser window, and coming back to a
small floating terminal afterward to read and copy a systemctl command by
hand was real, reported friction; nothing about the rest of setup needs a
human in the loop, so it isn't left as a manual step.

Every write to accounts.json goes through atomic_write_accounts: write to a
sibling temp file, then os.replace over the target, and refuse a target
that is a symlink first, matching the defensive pattern used throughout
Omarchy's first-party plugins.
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

STATE_HOME = Path.home() / ".config" / "omarchy-google-drive"
ACCOUNTS_FILE = STATE_HOME / "accounts.json"

# `add` runs interactively (a human is watching the terminal), but pause/
# resume/remove are also reachable straight from the panel with no human
# reviewing the command first — resolve rclone/notify-send from a fixed,
# trusted set of directories rather than inherited PATH, and systemctl
# outright (its location is standard on any systemd distro).
TRUSTED_PATH = "/usr/bin:/usr/local/bin"
SYSTEMCTL = "/usr/bin/systemctl"
MOUNT_ROOT = Path.home() / "GoogleDrive"
UNIT_TEMPLATE = "omarchy-google-drive-mount@{id}.service"
VALID_ID = re.compile(r"^[a-z0-9][a-z0-9-]{0,63}$")
EMAIL_RE = re.compile(r"^[^@\s]+@[^@\s]+\.[^@\s]+$")


def fail(message):
    print(f"googledrive-accountctl: {message}", file=sys.stderr)
    sys.exit(1)


def ensure_private_dir(path):
    if path.exists() and path.is_symlink():
        fail(f"refusing to use a symlinked directory: {path}")
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(path, 0o700)


def load_accounts():
    if not ACCOUNTS_FILE.exists():
        return []
    if ACCOUNTS_FILE.is_symlink():
        fail(f"refusing to read a symlinked accounts file: {ACCOUNTS_FILE}")
    try:
        with ACCOUNTS_FILE.open("r", encoding="utf-8") as handle:
            data = json.load(handle)
    except (OSError, json.JSONDecodeError):
        return []
    accounts = data.get("accounts") if isinstance(data, dict) else None
    return accounts if isinstance(accounts, list) else []


def atomic_write_accounts(accounts):
    ensure_private_dir(STATE_HOME)
    if ACCOUNTS_FILE.exists() and ACCOUNTS_FILE.is_symlink():
        fail(f"refusing to overwrite a symlinked accounts file: {ACCOUNTS_FILE}")
    tmp = ACCOUNTS_FILE.with_suffix(".json.tmp")
    with tmp.open("w", encoding="utf-8") as handle:
        json.dump({"accounts": accounts}, handle, indent=2)
        handle.write("\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, ACCOUNTS_FILE)


def find_account(accounts, account_id):
    for entry in accounts:
        if entry.get("id") == account_id:
            return entry
    return None


def slugify_email(email):
    """alice@gmail.com -> alice. Just the part before '@', sanitized to
    the id-safe charset — collisions between accounts that share a local
    part are handled separately by unique_id(), not by baking the domain
    into every id."""
    local_part = email.strip().lower().split("@", 1)[0]
    slug = re.sub(r"[^a-z0-9]+", "-", local_part).strip("-")
    if not slug:
        slug = "account"
    if not slug[0].isalnum():
        slug = "a" + slug
    return slug[:64]


def unique_id(base, accounts):
    """Append -2, -3, ... if base is already taken — collisions are
    possible in principle (two real emails slugifying the same isn't
    realistic, but this keeps `add` from ever failing on it)."""
    existing = {a.get("id") for a in accounts}
    if base not in existing:
        return base
    n = 2
    while f"{base}-{n}" in existing:
        n += 1
    return f"{base}-{n}"


def notify(summary, body="", urgency="normal"):
    """Best-effort desktop notification — so finishing sign-in doesn't
    require going back to find the floating terminal window (which Google's
    own OAuth consent screen, taking over the browser, tends to bury).
    Silently does nothing if notify-send isn't available; never raises."""
    notify_send = shutil.which("notify-send", path=TRUSTED_PATH)
    if not notify_send:
        return
    try:
        subprocess.run(
            [notify_send, "--app-name=Google Drives", f"--urgency={urgency}", summary, body],
            check=False, timeout=3, capture_output=True,
        )
    except (OSError, subprocess.TimeoutExpired):
        pass


def cmd_list(args):
    accounts = load_accounts()
    if not accounts:
        print("No accounts configured. Add one with: googledrive-accountctl add <email>")
        return
    for entry in accounts:
        print(f"{entry.get('id')}\t{entry.get('displayName')}\t{entry.get('mountPath')}")


def prompt(label, default=None):
    suffix = f" [{default}]" if default else ""
    value = input(f"{label}{suffix}: ").strip()
    return value or (default or "")


def _require_rclone():
    rclone = shutil.which("rclone", path=TRUSTED_PATH)
    if not rclone:
        fail("rclone is not installed — run the install script first")
    return rclone


def cmd_add(args):
    rclone = _require_rclone()  # fail before asking anything, not after

    email = (args.email or prompt("Google account email, e.g. alice@gmail.com")).strip()
    if not EMAIL_RE.match(email):
        fail("that doesn't look like an email address")
    display_name = email

    accounts = load_accounts()
    default_id = slugify_email(email)
    account_id = (args.id or unique_id(default_id, accounts)).strip().lower()
    if not VALID_ID.match(account_id):
        fail("--id must be lowercase letters, digits, and hyphens, starting with a letter or digit")
    if find_account(accounts, account_id):
        fail(f"account '{account_id}' already exists — remove it first: googledrive-accountctl remove {account_id}")

    account_dir = STATE_HOME / account_id
    ensure_private_dir(account_dir)
    mount_path = MOUNT_ROOT / display_name
    mount_path.mkdir(parents=True, exist_ok=True)
    config_path = account_dir / "rclone.conf"

    print()
    print(f"Signing in to Google Drive as {email}.")
    print("This is rclone's own browser sign-in — a browser window will open (or a")
    print("link will be printed below to open yourself) asking you to approve access")
    print("for this Google account. Nothing is typed into this terminal.")
    print()

    # rclone's own interactive OAuth flow — deliberately NOT run with
    # captured stdout/stderr (unlike a scripted create+verify call) because
    # it needs to print the auth URL and, on a machine without a local
    # browser, prompt "If your browser doesn't open...". scope=drive (not
    # drive.readonly / drive.file) so the mount can write as well as read.
    # config_is_local=true is rclone's default browser hand-off; see
    # README for the headless (config_is_local=false) alternative.
    create_result = subprocess.run(
        [rclone, "config", "create", account_id, "drive",
         "scope=drive", "config_is_local=true",
         "--config", str(config_path)],
    )
    if create_result.returncode != 0:
        shutil.rmtree(account_dir, ignore_errors=True)
        notify("Google Drive sign-in failed", email, urgency="critical")
        fail("Google sign-in was not completed — nothing was saved")

    print()
    print("Verifying the connection...")
    about = subprocess.run(
        [rclone, "about", f"{account_id}:", "--config", str(config_path), "--json"],
        capture_output=True, text=True, timeout=30,
    )
    if about.returncode != 0:
        shutil.rmtree(account_dir, ignore_errors=True)
        detail = (about.stderr or about.stdout or "").strip()
        notify("Google Drive sign-in failed", email, urgency="critical")
        fail(f"sign-in did not verify, nothing was saved. rclone said:\n  {detail or 'unknown error'}")

    accounts.append({
        "id": account_id,
        "displayName": display_name,
        "remote": account_id,
        "mountPath": str(mount_path),
    })
    atomic_write_accounts(accounts)

    env_path = account_dir / "env"
    with env_path.open("w", encoding="utf-8") as handle:
        handle.write(f"GOOGLEDRIVE_REMOTE={account_id}\n")
        handle.write(f"GOOGLEDRIVE_MOUNTPOINT={mount_path}\n")
        handle.write(f"GOOGLEDRIVE_CONFIG={config_path}\n")
    os.chmod(env_path, 0o600)

    # Nothing left for the browser-buried terminal to hand back to a human
    # for — start it now rather than printing a command to copy later.
    unit = UNIT_TEMPLATE.format(id=account_id)
    print()
    print(f"Signed in and verified. Mounting at {mount_path} ...")
    mount_result = subprocess.run([SYSTEMCTL, "--user", "enable", "--now", unit])
    if mount_result.returncode == 0:
        print("Done.")
        notify("Google Drive connected", f"{email} is mounted at {mount_path}")
    else:
        # Account is saved either way — the mount just didn't start. Not a
        # fail(): the sign-in itself succeeded and shouldn't be rolled back
        # over a systemd hiccup.
        print(f"Signed in, but the mount unit didn't start — check with:")
        print(f"  systemctl --user status {unit}")
        notify("Google Drive signed in, mount failed to start", email, urgency="critical")


def cmd_remove(args):
    accounts = load_accounts()
    entry = find_account(accounts, args.id)
    if not entry:
        fail(f"no such account: {args.id}")

    unit = UNIT_TEMPLATE.format(id=args.id)
    subprocess.call([SYSTEMCTL, "--user", "disable", "--now", unit],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    remaining = [a for a in accounts if a.get("id") != args.id]
    atomic_write_accounts(remaining)
    print(f"Removed '{args.id}' from Google Drives. Its rclone config and local mount folder were left in place:")
    print(f"  {STATE_HOME / args.id}")
    print(f"  {entry.get('mountPath', '')}")
    print("Delete them yourself once you've confirmed nothing still needs them.")


def _control(args, action, unit_state):
    accounts = load_accounts()
    entry = find_account(accounts, args.id)
    if not entry:
        fail(f"no such account: {args.id}")
    unit = UNIT_TEMPLATE.format(id=args.id)
    exit_code = subprocess.call([SYSTEMCTL, "--user", action, unit])
    if exit_code != 0:
        fail(f"systemctl --user {action} {unit} failed (exit {exit_code})")
    print(f"{args.id}: {unit_state}")


def cmd_pause(args):
    _control(args, "stop", "paused")


def cmd_resume(args):
    _control(args, "start", "resumed")


def main():
    parser = argparse.ArgumentParser(prog="googledrive-accountctl")
    sub = parser.add_subparsers(dest="command", required=True)

    p_list = sub.add_parser("list", help="list configured accounts")
    p_list.set_defaults(func=cmd_list)

    p_add = sub.add_parser("add", help="add and sign in to a new account")
    p_add.add_argument("email", nargs="?", default=None, help="Google account email, e.g. alice@gmail.com (prompted for if omitted)")
    p_add.add_argument("--id", dest="id", default=None, help="override the auto-generated id (default: derived from the email, e.g. alice-at-gmail-com)")
    p_add.set_defaults(func=cmd_add)

    p_remove = sub.add_parser("remove", help="stop and forget an account (keeps local files)")
    p_remove.add_argument("id")
    p_remove.set_defaults(func=cmd_remove)

    p_pause = sub.add_parser("pause", help="stop an account's mount unit")
    p_pause.add_argument("id")
    p_pause.set_defaults(func=cmd_pause)

    p_resume = sub.add_parser("resume", help="start an account's mount unit")
    p_resume.add_argument("id")
    p_resume.set_defaults(func=cmd_resume)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
